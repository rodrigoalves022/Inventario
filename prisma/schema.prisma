generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Conta contratante. Em MSP, possui varios Clients; em DIRECT, possui exatamente um
/// (a propria empresa). Manter o Client sempre presente garante um unico caminho de
/// escopo para todo o inventario, sem ramificacao por tipo de conta.
model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  type      String   @default("DIRECT") // MSP | DIRECT
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clients   Client[]
  users     User[]

  @@map("organizations")
}

model Client {
  id                        String      @id @default(cuid())
  organizationId            String
  organization              Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                      String
  slug                      String      @unique
  enrollmentKeyHash         String      @unique
  activeProvisioningKeyEnc  String?
  activeProvisioningSetAt   DateTime?
  alertsEnabled             Boolean     @default(true)
  alertWebhookEnabled       Boolean     @default(false)
  alertWebhookUrl           String?
  alertDiskThresholdGb      Int         @default(10)
  alertRamThresholdGb       Int         @default(4)
  alertOfflineHours         Int         @default(24)
  /// Dias de retencao de MetricSample antes do expurgo. Aplicado a cada
  /// ingestao de metrica (nao ha job separado): a tabela cresce ~4.300
  /// amostras/maquina/mes e nao pode ficar sem expurgo entre deploys.
  metricsRetentionDays      Int         @default(90)
  /// Sprint 14. Varredura de descoberta de rede pelo agente (DiscoveredDevice)
  /// e' OPT-IN, default DESLIGADO — decisao deliberada de privacidade/seguranca:
  /// um agente que varre portas de qualquer LAN em que a maquina se conecte
  /// (Wi-Fi de hotel, casa do funcionario, coworking) cataloga dispositivos de
  /// terceiros que nao pertencem ao tenant, e port scan nao solicitado e'
  /// comportamento que EDR/IDS classificam como malicioso. O gate que importa e'
  /// server-side e fail-closed (POST /api/agent/discovery responde 202
  /// 'discovery_disabled' sem gravar nada quando este flag e' false); o valor
  /// tambem viaja na resposta do check-in so para o agente nao gastar um ciclo
  /// de varredura inutil — nunca como a unica barreira.
  discoveryEnabled          Boolean     @default(false)
  isActive                  Boolean     @default(true)
  createdAt                 DateTime    @default(now())
  updatedAt                 DateTime    @updatedAt

  agents                    AgentAuth[]
  users                     User[]
  alertRules                AlertRule[]
  webhookEndpoints          WebhookEndpoint[]
  discoveredDevices         DiscoveredDevice[]

  @@index([name])
  @@index([organizationId])
  @@map("clients")
}

model AgentAuth {
  id          String    @id @default(cuid())
  clientId    String?
  client      Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  name        String
  apiKeyHash  String    @unique
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?

  device      Device?
  checkLogs   AgentCheckLog[]
  commands    AgentCommand[]

  @@index([clientId])
  @@index([apiKeyHash])
  @@map("agent_auths")
}

model Device {
  id          String    @id @default(cuid())
  agentAuthId String    @unique
  agentAuth   AgentAuth @relation(fields: [agentAuthId], references: [id], onDelete: Cascade)

  /// Desnormalizado a partir de agentAuth.clientId no check-in. Evita JOIN em toda
  /// consulta de tenant e reduz o risco de vazamento por JOIN esquecido.
  /// Nulo apenas para agentes legados registrados sem cliente.
  clientId    String?

  hostname    String
  serial      String?
  fabricante  String?
  modelo      String?
  dominio     String?
  usuario     String?
  anydeskId   String?
  status      String    @default("online")
  /// Sprint 11, item B. Preenchido a partir de body.agentVersion no check-in
  /// (lib/schemas/agent-checkin.ts) — o mesmo campo que ja alimentava so a
  /// mensagem do CollectionLog e a decisao de updateAvailable, agora tambem
  /// persistido por dispositivo. Nulo para agentes antigos que nunca
  /// reportaram esse campo, ou antes do primeiro check-in pos-migration.
  agentVersion String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  hardware    Hardware?
  networks    Network[]
  disks       Disk[]
  software    Software[]
  logs        CollectionLog[]
  checkLogs   AgentCheckLog[]
  security    SecurityPosture?
  localAccounts LocalAccount[]
  metrics     MetricSample[]
  monitors    Monitor[]
  printers    Printer[]
  usbDevices  UsbDevice[]
  assetRecord AssetRecord?
  alertEvents AlertEvent[]

  @@index([hostname])
  @@index([status])
  @@index([clientId])
  @@map("devices")
}

model Hardware {
  id                String  @id @default(cuid())
  deviceId          String  @unique
  device            Device  @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  sistema           String?
  versaoSO          String?
  processador       String?
  ramTotalGb        Int?
  slot1             String?
  slot2             String?
  slot3             String?
  slot4             String?
  placaMae          String?
  tipoArmazenamento String?

  @@map("hardware")
}

model Network {
  id         String  @id @default(cuid())
  deviceId   String
  device     Device  @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  ip         String?
  mac        String?
  gateway    String?
  dns        String?
  dhcp       Boolean @default(true)
  isPrimary  Boolean @default(false)

  @@index([deviceId])
  @@index([ip])
  @@map("networks")
}

model Disk {
  id            String  @id @default(cuid())
  deviceId      String
  device        Device  @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  unidade       String?
  modelo        String?
  tipo          String?
  capacidadeGb  Int?
  espacoLivreGb Int?
  /// Estado do BitLocker no volume: "on" | "off" | "unknown".
  /// Nulo quando o agente nao conseguiu consultar (falta de privilegio ou
  /// namespace de criptografia ausente) — diferente de "off", que e uma
  /// afirmacao de que o volume esta desprotegido.
  criptografia  String?

  @@index([deviceId])
  @@map("disks")
}

model Software {
  id           String   @id @default(cuid())
  deviceId     String
  device       Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  nome         String
  versao       String?
  editor       String?
  installadoEm DateTime?

  @@index([deviceId])
  @@index([nome])
  @@map("software")
}

model CollectionLog {
  id         String   @id @default(cuid())
  deviceId   String
  device     Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  ipOrigem   String?
  status     String   @default("success")
  mensagem   String?
  coletadoEm DateTime @default(now())

  @@index([deviceId])
  @@index([coletadoEm])
  @@map("collection_logs")
}

model AgentCheckLog {
  id          String    @id @default(cuid())
  agentAuthId String
  agentAuth   AgentAuth @relation(fields: [agentAuthId], references: [id], onDelete: Cascade)
  deviceId    String?
  device      Device?   @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  ipOrigem    String?
  status      String
  detailsJson String?
  createdAt   DateTime  @default(now())

  @@index([agentAuthId])
  @@index([deviceId])
  @@index([createdAt])
  @@map("agent_check_logs")
}

model AuditLog {
  id           String   @id @default(cuid())
  actorUserId  String?
  actorEmail   String?
  actorRole    String?
  clientId     String?
  action       String
  targetType   String
  targetId     String?
  metadataJson String?
  createdAt    DateTime @default(now())

  @@index([actorUserId])
  @@index([clientId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Postura de seguranca do endpoint, 1:1 com Device.
/// Todos os campos sao opcionais de proposito: `null` significa "nao foi
/// possivel apurar" e nunca deve ser exibido como "desativado". Em Windows
/// Server, por exemplo, o namespace SecurityCenter2 nao existe, entao antivirus
/// e firewall vem nulos mesmo havendo protecao ativa.
model SecurityPosture {
  id                  String   @id @default(cuid())
  deviceId            String   @unique
  device              Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  antivirusNome       String?
  antivirusAtivo      Boolean?
  antivirusAtualizado Boolean?
  firewallAtivo       Boolean?
  secureBootAtivo     Boolean?
  tpmPresente         Boolean?
  uacAtivo            Boolean?

  /// Motivo pelo qual parte da coleta ficou indisponivel, quando aplicavel.
  observacao          String?
  coletadoEm          DateTime @default(now())

  @@map("security_postures")
}

/// Contas locais do endpoint. Conta administradora habilitada e o achado que
/// mais aparece em auditoria de compliance.
model LocalAccount {
  id                   String  @id @default(cuid())
  deviceId             String
  device               Device  @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  usuario              String
  isAdmin              Boolean @default(false)
  habilitada           Boolean @default(true)
  senhaNuncaExpira     Boolean @default(false)

  @@index([deviceId])
  @@map("local_accounts")
}

/// Serie temporal de uso (CPU/RAM/disco/uptime), amostrada a cada ~10 min
/// pelo agente. E' a tabela que mais cresce no sistema (~4.300 amostras por
/// maquina/mes) — por isso o indice composto (deviceId, collectedAt), que
/// atende tanto o grafico de uma maquina quanto o corte por tenant, nasce
/// junto com a coleta, e o expurgo por retencao roda a cada ingestao em vez
/// de depender de um job externo que este projeto ainda nao tem onde rodar.
///
/// Campos numericos ficam nulos (nao 0) quando a coleta falhou: 0% de CPU
/// livre pareceria uma maquina ociosa em vez de um dado ausente.
model MetricSample {
  id             String   @id @default(cuid())
  deviceId       String
  device         Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  /// Desnormalizado a partir de device.clientId, mesmo motivo do Device:
  /// evita JOIN em toda consulta de retencao/corte por tenant nesta tabela
  /// grande.
  clientId       String?

  cpuPercent     Float?
  ramUsadaGb     Float?
  ramTotalGb     Float?
  discoUsadoGb   Float?
  discoLivreGb   Float?
  uptimeSegundos Int?

  collectedAt    DateTime @default(now())

  @@index([deviceId, collectedAt])
  @@index([collectedAt])
  @@index([clientId, collectedAt])
  @@map("metric_samples")
}

/// Monitor fisico conectado, apurado via WmiMonitorID (root\wmi) — Win32_DesktopMonitor
/// nao expoe fabricante/serie reais. Campos nulos quando o monitor nao reporta EDID
/// (comum em conexoes analogicas antigas ou monitores virtuais de RDP).
model Monitor {
  id         String  @id @default(cuid())
  deviceId   String
  device     Device  @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  fabricante String?
  modelo     String?
  serial     String?
  polegadas  Float?
  conexao    String?
  ano        Int?

  @@index([deviceId])
  @@map("monitors")
}

model Printer {
  id       String  @id @default(cuid())
  deviceId String
  device   Device  @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  nome     String
  porta    String?
  driver   String?
  padrao   Boolean @default(false)
  deRede   Boolean @default(false)

  @@index([deviceId])
  @@map("printers")
}

/// Dispositivos USB reais (nao hubs), identificados a partir do DeviceID do
/// Win32_PnPEntity (formato USB\VID_xxxx&PID_xxxx\serial).
model UsbDevice {
  id        String  @id @default(cuid())
  deviceId  String
  device    Device  @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  nome      String
  vendorId  String?
  productId String?
  serial    String?

  @@index([deviceId])
  @@map("usb_devices")
}

/// Dados de patrimonio/financeiro, 1:1 com Device. Preenchimento manual no
/// painel — NUNCA chega pelo agente e o check-in nunca escreve aqui. Um
/// upsert de inventario so toca as tabelas que o payload do agente cobre;
/// esta fica de fora por construcao, nao por um `if` que alguem podia
/// esquecer.
model AssetRecord {
  id              String    @id @default(cuid())
  deviceId        String    @unique
  device          Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  etiqueta        String?
  dataCompra      DateTime?
  notaFiscal      String?
  fornecedor      String?
  valor           Float?
  garantiaAte     DateTime?
  centroCusto     String?
  localizacao     String?
  responsavel     String?
  observacoes     String?

  updatedByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("asset_records")
}

/// Regra de alerta configurada pelo cliente, sobre metricas de seguranca ja
/// coletadas em B1 (antivirus/firewall/UAC/BitLocker) que ate aqui so
/// apareciam passivamente na aba Seguranca, sem gerar notificacao nem
/// historico. Catalogo fechado de `metric` em lib/alert-rules.ts — mesmo
/// principio do catalogo de comandos do agente, sem "regra livre".
model AlertRule {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  name      String
  metric    String
  severity  String   @default("warning") // "warning" | "critical"
  enabled   Boolean  @default(true)
  /// Sprint 12. So usado quando metric === 'software_blacklisted': o texto
  /// livre do nome do software a bloquear (ex: "uTorrent", "AnyDesk"),
  /// comparado case-insensitive por .includes() contra o nome de cada
  /// software coletado no check-in (lib/alert-rules.ts). Nulo para as
  /// demais 4 metricas (antivirus/firewall/UAC/BitLocker), que nao usam
  /// texto livre — catalogo fechado.
  pattern   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events    AlertEvent[]

  @@index([clientId])
  @@map("alert_rules")
}

/// Um disparo (e sua eventual resolucao) de uma AlertRule para um Device.
/// `resolvedAt` nulo = alerta aberto. Evita duplicar linha a cada check-in
/// enquanto a condicao persiste: so abre uma nova linha na transicao
/// ok->problema, e resolve na transicao problema->ok.
model AlertEvent {
  id         String     @id @default(cuid())
  clientId   String
  deviceId   String
  device     Device     @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  /// Nulo se a regra foi excluida depois do disparo — o historico do evento
  /// fica, so perde o vinculo com a regra viva.
  ruleId     String?
  rule       AlertRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  metric     String
  severity   String
  message    String
  /// Sprint 12. JSON serializado (mesmo padrao de AuditLog.metadataJson/
  /// AgentCheckLog.detailsJson — string, nao coluna JSON nativa) com detalhe
  /// estruturado do disparo. Hoje so preenchido para metric ===
  /// 'software_blacklisted' ({ softwareNome, softwareVersao }); nulo para as
  /// demais metricas, cuja mensagem em `message` ja e autoexplicativa.
  metadataJson String?

  firedAt    DateTime   @default(now())
  resolvedAt DateTime?

  @@index([clientId, firedAt])
  @@index([deviceId, ruleId])
  @@map("alert_events")
}

/// Sprint 11, item A. Webhook por tenant com filtro de eventos e assinatura
/// HMAC-SHA256 — mecanismo ADICIONAL/paralelo a
/// Client.alertWebhookEnabled/alertWebhookUrl (lib/alert-webhook.ts), que
/// continua funcionando exatamente como antes, sem nenhuma alteracao: aquele
/// e' um unico URL fixo por cliente, sem assinatura nem filtro de evento; este
/// permite VARIOS endpoints por cliente, cada um recebendo so os eventos que
/// escolheu, com o payload assinado (header X-Webhook-Signature).
///
/// `secret` NAO e' um hash (`secretHash`, como o pedido original citava):
/// HMAC-SHA256 precisa do segredo de volta a cada disparo pra recalcular a
/// assinatura (um hash e' unidirecional, nao serve pra assinar nada). Isso e'
/// diferente de Client.enrollmentKeyHash, que so precisa COMPARAR um hash
/// contra uma chave apresentada pelo agente, nunca devolve-la. Gerado no
/// servidor (crypto.randomBytes), nunca aceito de formulario; nunca devolvido
/// em texto pleno fora do instante da criacao (ver
/// app/app/[clientSlug]/settings/actions.ts). Cifrado em repouso desde a
/// Sprint 11/Backlog item 7 (AES-256-GCM, lib/webhook-endpoints.ts#encryptWebhookSecret,
/// mesmo nucleo de lib/encrypted-secret.ts usado por
/// lib/provisioning-credentials.ts) — o CAMPO continua `String`, so o
/// CONTEUDO passou a ser o payload cifrado serializado em vez do hex plano;
/// decifrado so no momento do disparo (dispatchClientWebhookEndpoints).
model WebhookEndpoint {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  url       String
  /// Catalogo fechado em lib/webhook-endpoints.ts (WEBHOOK_EVENTS) — os
  /// mesmos eventos ja emitidos hoje pelo caminho reativo do check-in e pela
  /// varredura de disponibilidade/disco.
  events    String[]
  isActive  Boolean  @default(true)
  secret    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@map("webhook_endpoints")
}

/// Sprint 14. Dispositivo de rede DESCOBERTO pela varredura do agente
/// (agent-go/internal/collectors/discovery) — impressora, switch, roteador,
/// NAS, access point. NAO e' um `Device`: nao tem agente instalado, nao faz
/// check-in, nao tem inventario de hardware/software. As duas tabelas nunca
/// se cruzam; um mesmo IP pode aparecer aqui e em `Network` sem qualquer
/// vinculo modelado — a descoberta e' um censo de rede, nao um inventario.
///
/// Escopado por `clientId` obrigatorio (nao nulavel, diferente de
/// `Device.clientId`): um agente legado sem tenant e' rejeitado na rota de
/// ingestao antes de qualquer escrita, justamente para nunca existir linha
/// orfa aqui. `onDelete: Cascade` — descoberta so faz sentido no contexto do
/// cliente que a produziu.
///
/// `@@unique([clientId, ip])` e' a chave do upsert por ciclo: a mesma
/// impressora reaparece a cada varredura (6h) e deve atualizar `lastSeenAt`,
/// nunca acumular uma linha por ciclo. `firstSeenAt` fica intocado no update —
/// e' a data em que aquele IP apareceu na rede daquele cliente pela primeira
/// vez.
model DiscoveredDevice {
  id           String   @id @default(cuid())
  clientId     String
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  ip           String
  /// Lido da tabela ARP do SO apos a varredura (os proprios probes TCP
  /// populam o cache ARP). Nulo quando o IP nao esta no cache ARP ou a
  /// plataforma nao implementa a leitura — nunca inventado.
  mac          String?
  hostname     String?
  /// Derivado prioritariamente do sysDescr/sysName do SNMP; como fallback,
  /// uma tabela minuscula de prefixos OUI embutida no agente (nao a base
  /// completa da IEEE, que sao ~35k prefixos e varios MB). Nulo quando
  /// nenhum dos dois resolve.
  vendor       String?
  /// Catalogo fechado espelhado em lib/schemas/agent-discovery.ts e no
  /// classificador do agente (mesmo principio de defesa em profundidade do
  /// catalogo de comandos, RNF003): PRINTER | SWITCH | ROUTER | NAS |
  /// ACCESS_POINT | UNKNOWN. `String` livre no banco por consistencia com o
  /// resto do schema (RNF012 — nenhum enum existe aqui).
  deviceType   String   @default("UNKNOWN")
  snmpSysDescr String?
  /// Portas que responderam, separadas por virgula (ex: "80,161,9100").
  /// 161 so entra quando um SNMP GET real por UDP respondeu — nao existe
  /// "porta 161 aberta" detectavel por TCP.
  openPorts    String?

  firstSeenAt  DateTime @default(now())
  lastSeenAt   DateTime @default(now())

  @@unique([clientId, ip])
  @@index([clientId, lastSeenAt])
  @@index([clientId, deviceType])
  @@map("discovered_devices")
}

model AgentCommand {
  id                 String    @id @default(cuid())
  agentAuthId        String
  agentAuth          AgentAuth @relation(fields: [agentAuthId], references: [id], onDelete: Cascade)
  clientId           String

  type               String    // "collect_now" | "restart_service" | "run_script"
  paramsJson         String?
  scriptId           String?   // referência a script pré-aprovado (catálogo), não texto livre

  status             String    @default("pending") // pending, running, done, failed, expired
  resultJson         String?

  requestedByUserId  String?
  createdAt          DateTime  @default(now())
  expiresAt          DateTime
  startedAt          DateTime?
  completedAt        DateTime?

  @@index([agentAuthId, status])
  @@index([clientId, createdAt])
  @@map("agent_commands")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  passwordHash  String
  /// PLATFORM_ADMIN (global) | ORG_ADMIN | ORG_OPERATOR (escopo Organization)
  /// | CLIENT_VIEWER (escopo Client, portal somente leitura)
  role          String    @default("ORG_ADMIN")
  /// Escopo do usuario. PLATFORM_ADMIN nao tem nenhum dos dois;
  /// ORG_* tem organizationId; CLIENT_VIEWER tem ambos.
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  clientId      String?
  client        Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([clientId])
  @@index([organizationId])
  @@map("users")
}
