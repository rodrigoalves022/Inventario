generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Conta contratante. Em MSP, possui varios Clients; em DIRECT, possui exatamente um
/// (a propria empresa). Manter o Client sempre presente garante um unico caminho de
/// escopo para todo o inventario, sem ramificacao por tipo de conta.
model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  type      String   @default("DIRECT") // MSP | DIRECT
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clients   Client[]
  users     User[]

  @@map("organizations")
}

model Client {
  id                        String      @id @default(cuid())
  organizationId            String
  organization              Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                      String
  slug                      String      @unique
  enrollmentKeyHash         String      @unique
  activeProvisioningKeyEnc  String?
  activeProvisioningSetAt   DateTime?
  alertsEnabled             Boolean     @default(true)
  alertWebhookEnabled       Boolean     @default(false)
  alertWebhookUrl           String?
  alertDiskThresholdGb      Int         @default(10)
  alertRamThresholdGb       Int         @default(4)
  alertOfflineHours         Int         @default(24)
  isActive                  Boolean     @default(true)
  createdAt                 DateTime    @default(now())
  updatedAt                 DateTime    @updatedAt

  agents                    AgentAuth[]
  users                     User[]

  @@index([name])
  @@index([organizationId])
  @@map("clients")
}

model AgentAuth {
  id          String    @id @default(cuid())
  clientId    String?
  client      Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  name        String
  apiKeyHash  String    @unique
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?

  device      Device?
  checkLogs   AgentCheckLog[]
  commands    AgentCommand[]

  @@index([clientId])
  @@index([apiKeyHash])
  @@map("agent_auths")
}

model Device {
  id          String    @id @default(cuid())
  agentAuthId String    @unique
  agentAuth   AgentAuth @relation(fields: [agentAuthId], references: [id], onDelete: Cascade)

  /// Desnormalizado a partir de agentAuth.clientId no check-in. Evita JOIN em toda
  /// consulta de tenant e reduz o risco de vazamento por JOIN esquecido.
  /// Nulo apenas para agentes legados registrados sem cliente.
  clientId    String?

  hostname    String
  serial      String?
  fabricante  String?
  modelo      String?
  dominio     String?
  usuario     String?
  status      String    @default("online")

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  hardware    Hardware?
  networks    Network[]
  disks       Disk[]
  software    Software[]
  logs        CollectionLog[]
  checkLogs   AgentCheckLog[]
  security    SecurityPosture?
  localAccounts LocalAccount[]

  @@index([hostname])
  @@index([status])
  @@index([clientId])
  @@map("devices")
}

model Hardware {
  id                String  @id @default(cuid())
  deviceId          String  @unique
  device            Device  @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  sistema           String?
  versaoSO          String?
  processador       String?
  ramTotalGb        Int?
  slot1             String?
  slot2             String?
  slot3             String?
  slot4             String?
  placaMae          String?
  tipoArmazenamento String?

  @@map("hardware")
}

model Network {
  id         String  @id @default(cuid())
  deviceId   String
  device     Device  @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  ip         String?
  mac        String?
  gateway    String?
  dns        String?
  dhcp       Boolean @default(true)
  isPrimary  Boolean @default(false)

  @@index([deviceId])
  @@index([ip])
  @@map("networks")
}

model Disk {
  id            String  @id @default(cuid())
  deviceId      String
  device        Device  @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  unidade       String?
  modelo        String?
  tipo          String?
  capacidadeGb  Int?
  espacoLivreGb Int?
  /// Estado do BitLocker no volume: "on" | "off" | "unknown".
  /// Nulo quando o agente nao conseguiu consultar (falta de privilegio ou
  /// namespace de criptografia ausente) — diferente de "off", que e uma
  /// afirmacao de que o volume esta desprotegido.
  criptografia  String?

  @@index([deviceId])
  @@map("disks")
}

model Software {
  id           String   @id @default(cuid())
  deviceId     String
  device       Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  nome         String
  versao       String?
  editor       String?
  installadoEm DateTime?

  @@index([deviceId])
  @@index([nome])
  @@map("software")
}

model CollectionLog {
  id         String   @id @default(cuid())
  deviceId   String
  device     Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  ipOrigem   String?
  status     String   @default("success")
  mensagem   String?
  coletadoEm DateTime @default(now())

  @@index([deviceId])
  @@index([coletadoEm])
  @@map("collection_logs")
}

model AgentCheckLog {
  id          String    @id @default(cuid())
  agentAuthId String
  agentAuth   AgentAuth @relation(fields: [agentAuthId], references: [id], onDelete: Cascade)
  deviceId    String?
  device      Device?   @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  ipOrigem    String?
  status      String
  detailsJson String?
  createdAt   DateTime  @default(now())

  @@index([agentAuthId])
  @@index([deviceId])
  @@index([createdAt])
  @@map("agent_check_logs")
}

model AuditLog {
  id           String   @id @default(cuid())
  actorUserId  String?
  actorEmail   String?
  actorRole    String?
  clientId     String?
  action       String
  targetType   String
  targetId     String?
  metadataJson String?
  createdAt    DateTime @default(now())

  @@index([actorUserId])
  @@index([clientId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Postura de seguranca do endpoint, 1:1 com Device.
/// Todos os campos sao opcionais de proposito: `null` significa "nao foi
/// possivel apurar" e nunca deve ser exibido como "desativado". Em Windows
/// Server, por exemplo, o namespace SecurityCenter2 nao existe, entao antivirus
/// e firewall vem nulos mesmo havendo protecao ativa.
model SecurityPosture {
  id                  String   @id @default(cuid())
  deviceId            String   @unique
  device              Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  antivirusNome       String?
  antivirusAtivo      Boolean?
  antivirusAtualizado Boolean?
  firewallAtivo       Boolean?
  secureBootAtivo     Boolean?
  tpmPresente         Boolean?
  uacAtivo            Boolean?

  /// Motivo pelo qual parte da coleta ficou indisponivel, quando aplicavel.
  observacao          String?
  coletadoEm          DateTime @default(now())

  @@map("security_postures")
}

/// Contas locais do endpoint. Conta administradora habilitada e o achado que
/// mais aparece em auditoria de compliance.
model LocalAccount {
  id                   String  @id @default(cuid())
  deviceId             String
  device               Device  @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  usuario              String
  isAdmin              Boolean @default(false)
  habilitada           Boolean @default(true)
  senhaNuncaExpira     Boolean @default(false)

  @@index([deviceId])
  @@map("local_accounts")
}

model AgentCommand {
  id                 String    @id @default(cuid())
  agentAuthId        String
  agentAuth          AgentAuth @relation(fields: [agentAuthId], references: [id], onDelete: Cascade)
  clientId           String

  type               String    // "collect_now" | "restart_service" | "run_script"
  paramsJson         String?
  scriptId           String?   // referência a script pré-aprovado (catálogo), não texto livre

  status             String    @default("pending") // pending, running, done, failed, expired
  resultJson         String?

  requestedByUserId  String?
  createdAt          DateTime  @default(now())
  expiresAt          DateTime
  startedAt          DateTime?
  completedAt        DateTime?

  @@index([agentAuthId, status])
  @@index([clientId, createdAt])
  @@map("agent_commands")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  passwordHash  String
  /// PLATFORM_ADMIN (global) | ORG_ADMIN | ORG_OPERATOR (escopo Organization)
  /// | CLIENT_VIEWER (escopo Client, portal somente leitura)
  role          String    @default("ORG_ADMIN")
  /// Escopo do usuario. PLATFORM_ADMIN nao tem nenhum dos dois;
  /// ORG_* tem organizationId; CLIENT_VIEWER tem ambos.
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  clientId      String?
  client        Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([clientId])
  @@index([organizationId])
  @@map("users")
}
