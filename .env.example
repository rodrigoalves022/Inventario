# ─── Banco de Dados ───────────────────────────────────────────────────────────────
# PostgreSQL. Suba o banco local com: docker compose up -d db
DATABASE_URL="postgresql://inventario:inventario@localhost:5432/inventario?schema=public"

# SQLite continua funcionando para desenvolvimento offline, mas exige trocar
# `provider` em prisma/schema.prisma para "sqlite":
# DATABASE_URL="file:./dev.db"

# ─── Autenticação do painel ───────────────────────────────────────────────────────
# Usada pelo NextAuth para assinar a sessão. Obrigatória.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="TROQUE_PARA_UMA_CHAVE_FORTE_ALEATORIA"

# ─── Segurança do Servidor ────────────────────────────────────────────────────────
# Protege o registro administrativo de agentes e o bootstrap do primeiro
# PLATFORM_ADMIN (POST /api/auth/signup).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET="TROQUE_PARA_UMA_CHAVE_FORTE_ALEATORIA"

# Criptografa o pacote de provisionamento exibível do cliente.
# Se ausente, usa AUTH_SECRET e depois ADMIN_SECRET como fallback.
INVENTARIO_PROVISIONING_SECRET="TROQUE_PARA_UMA_CHAVE_FORTE_ALEATORIA"

# ─── Endereço do servidor ─────────────────────────────────────────────────────────
# Endereço que os agentes usam para enviar inventário. Se ausente, é inferido
# do cabeçalho Host da requisição.
# INVENTARIO_SERVER_URL="https://inventario.suaempresa.com"

# ─── Ambiente ────────────────────────────────────────────────────────────────────
NODE_ENV="development"
