# ─── Banco de Dados ───────────────────────────────────────────────────────────────
# SQLite (desenvolvimento):
DATABASE_URL="file:./dev.db"

# PostgreSQL (producao):
# DATABASE_URL="postgresql://usuario:senha@localhost:5432/inventario_db"

# ─── Segurança do Servidor ────────────────────────────────────────────────────────
# Chave secreta para proteger o endpoint de registro de agentes (/api/agent/register)
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET="TROQUE_PARA_UMA_CHAVE_FORTE_ALEATORIA"

# ─── (opcional) JWT para autenticação do painel web ─────────────────────────────
# Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="TROQUE_PARA_UMA_CHAVE_JWT_FORTE"

# ─── Ambiente ────────────────────────────────────────────────────────────────────
NODE_ENV="development"
# NODE_ENV="production"

# Chave dedicada para criptografar o pacote ativo de provisionamento exibível
# Se ausente, o sistema usa AUTH_SECRET e depois ADMIN_SECRET como fallback.
INVENTARIO_PROVISIONING_SECRET="TROQUE_PARA_UMA_CHAVE_FORTE_ALEATORIA"
